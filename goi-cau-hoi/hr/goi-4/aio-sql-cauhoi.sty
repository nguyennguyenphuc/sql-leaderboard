% ---------------------------------------------------------------- tiện ích
\newcommand{\cq@err}[1]{\PackageError{aio-sql-cauhoi}{#1}{Xem DAC_TA_CHUAN_LATEX.md}}
% \code{...}: tên bảng, cột, giá trị trong câu chữ; không cần escape dấu gạch dưới
\newcommand{\code}[1]{\texttt{\detokenize{#1}}}
\newcommand{\cq@chip}[2][cqMuted]{%
  \tcbox[on line, boxsep=0pt, left=4pt, right=4pt, top=1.5pt, bottom=1.5pt, arc=6pt,
    colback=white, colframe=#1, boxrule=0.6pt]{\color{#1}\footnotesize #2}}
\newcommand{\cq@label}[1]{\par\smallskip{\color{cqMuted}\scriptsize\bfseries\MakeUppercase{#1}}\par\nopagebreak}

% ---------------------------------------------------------------- khai báo dùng chung
% \khaibaodulieu{ma}{Tên}{Mô tả}
\newcommand{\khaibaodulieu}[3]{\csdef{cq@ds@#1}{#2}\csdef{cq@dsd@#1}{#3}}
% \khaibaodomain{ma}{Tên}{Mô tả mảng nghiệp vụ}
\newcommand{\khaibaodomain}[3]{\csdef{cq@dm@#1}{#2}\csdef{cq@dmd@#1}{#3}}
% \khaibaokhainiem{ma}{Tên}{Định nghĩa}{Công thức (có thể rỗng)}{Trong bộ dữ liệu}
\newcommand{\khaibaokhainiem}[5]{%
  \csdef{cq@kn@#1}{#2}\csdef{cq@knd@#1}{#3}\csdef{cq@knf@#1}{#4}\csdef{cq@kni@#1}{#5}}

% danh sách giá trị cố định
\newcommand{\cq@allow}[2]{\csdef{cq@ok@#1@#2}{}}
\forcsvlist{\cq@allow{dang}}{A1,A2,A3,A4,B1,B2,B3,B4,C1,C2,C3,C4,D1,D2,D3,E1,E2,E3}
\newcommand{\cq@need}[3]{% #1 kho, #2 giá trị, #3 tên khoá
  \ifcsdef{#1#2}{}{\cq@err{Gia tri '#2' cua khoa '#3' chua khai bao hoac khong hop le}}}

% ---------------------------------------------------------------- khoá của \begin{cauhoi}[...]
\newcounter{cauhoi}
\newcounter{cqgoiy}[cauhoi]
\newcounter{cqbuoc}[cauhoi]
\pgfkeys{
  /cq/.is family, /cq,
  ma/.store in=\cq@ma,
  dulieu/.store in=\cq@dulieu,
  domain/.store in=\cq@domain,
  dang/.store in=\cq@dang,
  kynang/.store in=\cq@kynang,
  bay/.store in=\cq@bay,
  tacgia/.store in=\cq@tacgia,
  diem/.store in=\cq@diemghi,
  bokiemtra/.store in=\cq@bokiemtra,
  saiso/.store in=\cq@saiso,
  hinhthuc/.is choice,
  hinhthuc/write/.code={\def\cq@ht{write}\def\cq@htn{Viết truy vấn}},
  hinhthuc/debug/.code={\def\cq@ht{debug}\def\cq@htn{Sửa lỗi}},
  hinhthuc/optimize/.code={\def\cq@ht{optimize}\def\cq@htn{Tối ưu truy vấn}},
  hinhthuc/case/.code={\def\cq@ht{case}\def\cq@htn{Case study}},
  % ràng buộc của câu optimize: số lần quét tối đa mỗi bảng; ngân sách dòng trung gian (bội số của lời giải)
  quettoida/.store in=\cq@quet,
  ngansach/.store in=\cq@ngansach,
  cap/.is choice,
  cap/basic/.code={\def\cq@cap{basic}\def\cq@capn{Cơ bản}\def\cq@capc{cqBasic}\def\cq@diem{10}},
  cap/easy/.code={\def\cq@cap{easy}\def\cq@capn{Dễ}\def\cq@capc{cqEasy}\def\cq@diem{20}},
  cap/medium/.code={\def\cq@cap{medium}\def\cq@capn{Trung bình}\def\cq@capc{cqMedium}\def\cq@diem{30}},
  cap/hard/.code={\def\cq@cap{hard}\def\cq@capn{Khó}\def\cq@capc{cqHard}\def\cq@diem{50}},
  trangthai/.is choice,
  trangthai/nhap/.code={\def\cq@tt{nháp}},
  trangthai/review/.code={\def\cq@tt{review}},
  trangthai/duyet/.code={\def\cq@tt{duyệt}},
  thutu/.is choice,
